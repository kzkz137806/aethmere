{
  "name": "aethmere-vscode",
  "displayName": "Aethmere — Governed Context",
  "description": "Use independently governed project context through Aethmere Agent 0.12.0 or later.",
  "version": "0.12.0",
  "publisher": "aethmere",
  "license": "SEE LICENSE IN LICENSE.txt",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "Aethmere",
    "AI",
    "MCP",
    "local context",
    "privacy"
  ],
  "activationEvents": [
    "onView:aethmere.contextView",
    "onCommand:aethmere.initialize",
    "onCommand:aethmere.saveSelection",
    "onCommand:aethmere.openContext",
    "onCommand:aethmere.connectClients",
    "onCommand:aethmere.checkSetup",
    "onCommand:aethmere.refresh",
    "onCommand:aethmere.openDownloads"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kzkz137806/aethmere.git",
    "directory": "vscode"
  },
  "homepage": "https://aethmere.com/downloads/",
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.cjs",
    "package:vsix": "node bin/package-vsix.mjs",
    "verify:vsix": "node bin/verify-vsix.mjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "aethmere.initialize",
        "title": "Aethmere: Initialize Governed Context"
      },
      {
        "command": "aethmere.saveSelection",
        "title": "Aethmere: Save Selection as Context"
      },
      {
        "command": "aethmere.openContext",
        "title": "Aethmere: Show Governed Context"
      },
      {
        "command": "aethmere.connectClients",
        "title": "Aethmere: Connect Supported Clients"
      },
      {
        "command": "aethmere.checkSetup",
        "title": "Aethmere: Check Agent Client"
      },
      {
        "command": "aethmere.refresh",
        "title": "Aethmere: Refresh Governed Context"
      },
      {
        "command": "aethmere.openDownloads",
        "title": "Aethmere: Download Supported Clients"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "aethmere.contextView",
          "name": "Aethmere Context"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "aethmere.saveSelection",
          "when": "editorHasSelection",
          "group": "navigation@20"
        }
      ],
      "view/title": [
        {
          "command": "aethmere.refresh",
          "when": "view == aethmere.contextView",
          "group": "navigation"
        },
        {
          "command": "aethmere.openContext",
          "when": "view == aethmere.contextView",
          "group": "navigation"
        }
      ]
    }
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2",
    "yauzl": "3.2.1"
  }
}
